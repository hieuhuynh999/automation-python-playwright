# =============================================================================
# eFMS/eTMS Automation — copy to .env and fill in credentials
# =============================================================================

# --- Runtime ---
# UAT | DEV — URLs & accounts: src/automation/config/environments.json
ENV=UAT

# --- Browser (pytest: --browser chrome|edge, --browser-headless true|false) ---
BROWSER=chrome
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=60000
BROWSER_SLOW_MO=0
PAGE_LOAD_TIMEOUT=60000
COMPONENT_INTERACTION_TIMEOUT=15000
QUICK_ACTION_TIMEOUT=5000
TAB_SWITCH_TIMEOUT=10000
POLLING_INTERVAL=250
NAVIGATION_SETTLE_MS=1000
OPEN_URL_SETTLE_MS=5000
HEADLESS_VIEWPORT_WIDTH=1920
HEADLESS_VIEWPORT_HEIGHT=1080

# --- Application URLs & credentials ---
# copy src\automation\config\environments.example.json → environments.json (gitignored)
# Optional per-field override in .env: EFMS_BASE_URL, VFC_ETMS_BASE_URL, *_ACCOUNT_*

# --- ReportPortal (auto-enabled when RP_API_KEY is set) ---
# UI: http://localhost:8080/ui/#default_personal/launches/all
RP_ENDPOINT=http://10.50.1.26:8080
RP_PROJECT=default_personal
RP_API_KEY=
RP_VERIFY_SSL=false
# Separate launches — run: pytest -m efms / pytest -m etms (or tests/efms, tests/etms)
RP_LAUNCH_EFMS=efms-automation
RP_LAUNCH_ETMS=etms-automation
RP_LAUNCH_DESCRIPTION_EFMS=eFMS UI automation
RP_LAUNCH_DESCRIPTION_ETMS=eTMS UI automation

# --- Test retry (pytest-rerunfailures) ---
# Failed tests rerun TEST_RERUNS times; pytest logs each attempt, ReportPortal keeps final result only
TEST_RERUNS=0
TEST_RERUNS_DELAY=2
